# Copy to .env.local to enable cloud-generated AI Notes.
# Without a key, Milo's built-in local summary engine (smart-local) is used.
GEMINI_API_KEY=

# Optional model override. Default: gemini-2.5-flash
GEMINI_MODEL=

# Required only when the Next.js app is hosted on Vercel: URL of the external
# Socket.io/WebRTC signaling server, e.g. https://milo-signaling.onrender.com
# Leave empty for same-origin local development (node server.js).
NEXT_PUBLIC_SIGNALING_URL=
