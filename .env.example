# Copy to .env.local.

# --- AI Notes -----------------------------------------------------------------
# Without a key, Milo's built-in local summary engine (smart-local) is used.
GEMINI_API_KEY=

# Optional model override. Default: gemini-2.5-flash
GEMINI_MODEL=

# --- Signaling ----------------------------------------------------------------
# Option A (Vercel-friendly, recommended): Supabase Realtime.
# When both values are set, meetings use Supabase Broadcast + Presence and no
# Socket.io server is required. Create a free project at https://supabase.com
# and copy the Project URL and anon/public key from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Option B: external Socket.io server (server.js on Render/Railway/Fly).
# Leave empty for same-origin local development (node server.js).
# Takes effect only when the Supabase values above are empty.
NEXT_PUBLIC_SIGNALING_URL=
